---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const artworks = await getCollection('art');
  return artworks.map((art) => ({
    params: { id: art.id },
    props: { art }
  }));
}

const { art } = Astro.props;
const { Content } = await render(art);
---

<BaseLayout title={`${art.data.title} — Art`} description={art.data.medium}>
  <article>
    <header class="mb-8">
      <h1 class="text-3xl font-bold tracking-tight text-neutral-100">{art.data.title}</h1>
      <p class="mt-2 text-sm text-neutral-500">{art.data.medium}</p>
      {
        art.data.tags.length > 0 && (
          <ul class="mt-3 flex flex-wrap gap-2">
            {art.data.tags.map((tag) => (
              <li class="rounded-full bg-neutral-800 px-3 py-1 text-xs text-neutral-300">{tag}</li>
            ))}
          </ul>
        )
      }
    </header>
    <div class="grid grid-cols-1 gap-6">
      {art.data.images.map((img) => <Image src={img} alt={art.data.title} class="w-full rounded-lg" />)}
    </div>
    <div class="mt-8">
      <Content />
    </div>
  </article>
</BaseLayout>
