---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Your Name — Art, Games &amp; Code">
  <section class="py-16">
    <h1 class="text-4xl font-bold tracking-tight text-neutral-100 sm:text-5xl">
      Digital art, games, and web projects.
    </h1>
    <p class="mt-4 max-w-xl text-lg text-neutral-400">
      I paint, build games, and write code. This is where I show the results and write about how
      I made them.
    </p>
    <div class="mt-8 flex gap-4">
      <a
        href="/art/"
        class="rounded-md bg-neutral-100 px-5 py-2.5 text-sm font-semibold text-neutral-950 hover:bg-white"
      >
        View Art
      </a>
      <a
        href="/projects/"
        class="rounded-md border border-neutral-700 px-5 py-2.5 text-sm font-semibold text-neutral-100 hover:border-neutral-500"
      >
        View Projects
      </a>
    </div>
  </section>
</BaseLayout>
