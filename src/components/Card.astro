---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  href: string;
  title: string;
  meta?: string;
  image?: ImageMetadata;
}

const { href, title, meta, image } = Astro.props;
---

<a
  href={href}
  class="group block overflow-hidden rounded-lg border border-neutral-800 transition-colors hover:border-neutral-600"
>
  {
    image && (
      <Image
        src={image}
        alt={title}
        class="aspect-video w-full object-cover transition-transform group-hover:scale-105"
        widths={[300, 600]}
        sizes="(min-width: 768px) 300px, 100vw"
      />
    )
  }
  <div class="p-4">
    <h3 class="font-semibold text-neutral-100">{title}</h3>
    {meta && <p class="mt-1 text-sm text-neutral-500">{meta}</p>}
  </div>
</a>
